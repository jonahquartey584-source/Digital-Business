# Copy this file to .env.local for local development, and set the same
# values in your hosting provider's dashboard (e.g. Netlify) for production.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — server-only, NEVER expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe (Developers → API keys) ---
STRIPE_SECRET_KEY=sk_test_...
# Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# Products → CRM plan → the recurring Price's ID (starts with "price_")
STRIPE_CRM_PRICE_ID=price_...
# Products → AI Reception plan → the recurring Price's ID
STRIPE_VOICE_PRICE_ID=price_...

# --- AI Reception (voice module) ---
# console.anthropic.com → API Keys. Used to generate the AI's live phone
# replies and per-call summaries.
ANTHROPIC_API_KEY=sk-ant-...
# Encrypts each client's Twilio Auth Token at rest (they enter their own —
# see app/dashboard/voice). Generate with: openssl rand -base64 32
ENCRYPTION_KEY=...

# --- App ---
# Public URL of this deployment (used for Stripe redirect/callback URLs,
# and to build each client's Twilio webhook URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
