# Copy this file to .env.local for local development, and set the same
# values in your hosting provider's dashboard (e.g. Vercel) for production.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — server-only, NEVER expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Stripe (Developers → API keys) ---
STRIPE_SECRET_KEY=sk_test_...
# Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# Products → CRM plan → the recurring Price's ID (starts with "price_")
STRIPE_CRM_PRICE_ID=price_...

# --- App ---
# Public URL of this deployment (used for Stripe redirect/callback URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
