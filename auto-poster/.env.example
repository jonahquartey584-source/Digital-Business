# Copy this file to .env and fill in real values.
# Never commit your real .env file — it holds live credentials.

# ---------------------------------------------------------------------------
# YouTube (YouTube Data API v3)
# Create a project + OAuth client at https://console.cloud.google.com
# Enable "YouTube Data API v3", create an OAuth 2.0 Client ID (Desktop app),
# then run `node src/publishers/youtube.js --auth` once to mint a refresh token.
# ---------------------------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Instagram (Instagram Graph API — requires a Business/Creator account
# linked to a Facebook Page, and a Meta developer app with
# instagram_content_publish permission).
# https://developers.facebook.com/docs/instagram-api/guides/content-publishing
# ---------------------------------------------------------------------------
IG_USER_ID=
IG_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# TikTok (Content Posting API — requires an approved app in
# https://developers.tiktok.com and a user access token with
# video.publish scope).
# ---------------------------------------------------------------------------
TIKTOK_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Snapchat — Snapchat has no public API for unattended posting to a
# personal Story/Spotlight. See README.md "Snapchat limitations" for what
# this integration can and can't do.
# ---------------------------------------------------------------------------
SNAPCHAT_CREATIVE_KIT_APP_ID=

# ---------------------------------------------------------------------------
# Optional: base URL where local media files are served from (see
# `npm run serve-media`), used to build public mediaUrl values for
# Instagram/TikTok "pull from URL" publishing.
# ---------------------------------------------------------------------------
MEDIA_BASE_URL=http://localhost:4000/media
