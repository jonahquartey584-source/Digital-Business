# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
PORT=3000

# Public HTTPS base URL for this app. eBay, Instagram and Facebook do NOT
# accept image uploads -- they fetch images from a URL you give them, so your
# /media folder must be reachable from the public internet.
# Local dev: run `cloudflared tunnel --url http://localhost:3000` (or ngrok)
# and paste the https URL it prints here.
PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Access control
#
# The password that unlocks the page. Generate the hash with:
#   npm run set-password
# Leave this EMPTY and the app refuses every non-localhost request, so you
# cannot accidentally publish an unprotected instance.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD_HASH=
SESSION_TTL_DAYS=30

# Set to 1 when running behind a reverse proxy (Cloudflare Tunnel, nginx,
# Caddy) so the real client IP and https scheme are read from its headers.
TRUST_PROXY=0

# Interface to bind. Leave unset for 0.0.0.0 once a password is set; with no
# password the app forces 127.0.0.1 regardless.
# HOST=0.0.0.0

# Optional second way in, for scripts and cron rather than a browser
# (sent as the X-API-Key header). Not needed for normal use.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
APP_API_KEY=

# Branding burned into generated story images
BRAND_NAME=My Closet
BRAND_HANDLE=@myshop
STORY_CALL_TO_ACTION=DM to buy

# ---------------------------------------------------------------------------
# eBay  (developer.ebay.com -> your app keys; Sell APIs)
# ---------------------------------------------------------------------------
EBAY_ENV=production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_MERCHANT_LOCATION_KEY=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_DEFAULT_CATEGORY_ID=
EBAY_CONDITION=USED_EXCELLENT

# ---------------------------------------------------------------------------
# Etsy  (developers.etsy.com -> Open API v3)
# ---------------------------------------------------------------------------
ETSY_API_KEY=
ETSY_CLIENT_SECRET=
ETSY_REFRESH_TOKEN=
ETSY_SHOP_ID=
ETSY_SHIPPING_PROFILE_ID=
ETSY_RETURN_POLICY_ID=
ETSY_TAXONOMY_ID=
ETSY_WHO_MADE=someone_else
ETSY_WHEN_MADE=before_2004

# ---------------------------------------------------------------------------
# Shopify  (custom app in your store admin -> Admin API access token)
# ---------------------------------------------------------------------------
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-01

# ---------------------------------------------------------------------------
# Instagram  (Business/Creator account linked to a Facebook Page)
# Needs scopes: instagram_basic, instagram_content_publish, pages_show_list
# ---------------------------------------------------------------------------
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Facebook Page  (Page access token; scopes: pages_manage_posts, pages_read_engagement)
# NOTE: the API can post to a PAGE's feed and story, not a personal profile.
# ---------------------------------------------------------------------------
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
GRAPH_API_VERSION=v21.0

# ---------------------------------------------------------------------------
# Snapchat  (Public Profile API — developers.snap.com)
#
# Posts to your Snapchat PUBLIC PROFILE story. Public Profiles are free to
# create in the Snapchat app; a personal My Story cannot be posted to by any
# API (use the "Story handoff (phone)" channel for that).
#
# Your client ID must be added to Snap's Public Profile API allowlist before
# these work. After approval, check your setup with:
#   npm run snapchat:verify -- --media
# ---------------------------------------------------------------------------
SNAPCHAT_PROFILE_ID=
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
SNAPCHAT_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Browser-automation channels (Poshmark / Depop / Mercari / Marketplace / OfferUp)
# These have no public listing API. Log in once per channel with:
#   npm run login -- poshmark
# Set to 1 to watch the browser while it posts (useful for debugging selectors).
# ---------------------------------------------------------------------------
BROWSER_HEADFUL=0
BROWSER_SLOWMO_MS=0
# Fill the listing form and screenshot it WITHOUT publishing. Use this the
# first time you post to each browser channel, to check the selectors landed.
BROWSER_DRY_RUN=0
# Only needed if Chromium is already on the system (e.g. in a container) and
# you'd rather not let Playwright download its own.
# CHROMIUM_PATH=/usr/bin/chromium

# Where the app keeps its database, photos and browser sessions.
# DATA_DIR=./data
