# Block direct web access to config.php (it holds real credentials).
# Covers both older (2.2) and current (2.4+) Apache — InfinityFree's
# exact version can vary.
<IfModule mod_authz_core.c>
  <Files "config.php">
    Require all denied
  </Files>
</IfModule>
<IfModule !mod_authz_core.c>
  <Files "config.php">
    Order allow,deny
    Deny from all
  </Files>
</IfModule>

# Many Apache/PHP setups strip the Authorization header before PHP ever
# sees it. admin_auth.php needs it (the admin session token travels as
# "Authorization: Bearer <token>"), so forward it explicitly.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} ^(.+)$
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]
</IfModule>
<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>
