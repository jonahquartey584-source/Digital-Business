{
  "name": "qp-digital-crm-desktop",
  "version": "1.0.1",
  "private": true,
  "description": "Qp Digital CRM desktop application",
  "main": "main.cjs",
  "scripts": {
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "co.uk.qpdigital.crm",
    "productName": "Qp Digital CRM",
    "asar": true,
    "files": [
      "main.cjs",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "icon": "build/app.icns",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "artifactName": "Qp-Digital-CRM-Mac-${arch}.${ext}",
      "category": "public.app-category.business"
    },
    "win": {
      "icon": "build/app.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Qp-Digital-CRM-Windows-Setup.${ext}"
    },
    "dmg": {
      "background": "build/dmg-background.png",
      "window": {
        "width": 660,
        "height": 440
      },
      "contents": [
        {
          "x": 180,
          "y": 245,
          "type": "file"
        },
        {
          "x": 480,
          "y": 245,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
